# Live IRS connectivity is OFF by default.
IRS_LIVE_ENABLED=false

# Kill switch defaults ON. Explicit approved release must set false.
IRS_KILL_SWITCH=true

# Store only references to managed secret/vault records here; never raw credentials.
IRS_CLIENT_ID_REF=secret://irs/eservices/client-id
IRS_CREDENTIAL_REF=secret://irs/eservices/credential
IRS_CERTIFICATE_REF=secret://irs/eservices/client-certificate

# Must be supplied only after formal approval/review of the exact product adapter.
IRS_PRODUCT_ADAPTER_URL=

IRS_JIT_MAX_MINUTES=30
